{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4180 --strictPort",
      "startServerReadyPattern": "4180",
      "url": ["http://localhost:4180/"],
      "numberOfRuns": 3,
      "settings": { "preset": "perf", "formFactor": "mobile", "throttlingMethod": "simulate", "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:pwa": "off",
        "first-contentful-paint": ["warn", { "maxNumericValue": 3500 }],
        "interactive": ["error", { "maxNumericValue": 9000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
